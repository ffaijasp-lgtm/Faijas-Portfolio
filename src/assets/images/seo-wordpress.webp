<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800" width="1200" height="800">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#050505" />
      <stop offset="100%" stop-color="#121212" />
    </linearGradient>
    <radialGradient id="glow" cx="80%" cy="20%" r="60%">
      <stop offset="0%" stop-color="#FFDE00" stop-opacity="0.25" />
      <stop offset="100%" stop-color="transparent" stop-opacity="0" />
    </radialGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255,255,255,0.03)" stroke-width="1"/>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill="url(#bg)" />
  <rect width="100%" height="100%" fill="url(#grid)" />
  <circle cx="960" cy="200" r="480" fill="url(#glow)" />
  
  <!-- Film Strip Perforations header -->
  <rect x="0" y="0" width="1200" height="28" fill="#FFDE00" />
  <text x="24" y="19" font-family="'Courier New', monospace" font-size="11" font-weight="900" fill="#000000" letter-spacing="2">FAIJAS P // PORTFOLIO ARCHIVE // 4K PRODUCTION</text>

  <g transform="translate(60, 416)">
    <rect x="0" y="-32" width="130" height="26" fill="#FFDE00" />
    <text x="65" y="-15" font-family="sans-serif" font-size="11" font-weight="900" fill="#000000" text-anchor="middle" letter-spacing="1.5">CASE STUDY</text>
    <text x="0" y="24" font-family="sans-serif" font-size="36" font-weight="900" fill="#FFFFFF" letter-spacing="-0.5">WORDPRESS &amp; ON-PAGE SEO</text>
    <text x="0" y="60" font-family="sans-serif" font-size="17" font-weight="500" fill="#A3A3A3">Content Structure, Metadata &amp; Search Visibility</text>
  </g>
  
  <line x1="60" y1="760" x2="1140" y2="760" stroke="rgba(255,255,255,0.1)" stroke-width="1" />
  <text x="60" y="780" font-family="'Courier New', monospace" font-size="11" fill="#737373" letter-spacing="1">DIGITAL MARKETING • AI VIDEO PRODUCTION • ON-PAGE SEO</text>
</svg>